              "null"
            ],
            "format": "uuid",
            "description": "Last returned User ID if another page exists; null otherwise."
          }
        }
      },
      "PeoplePermissionId": {
        "type": "string",
        "enum": ["session.read.self", "user.read.self", "user.read", "user.manage", "organization.manage", "venue.read", "venue.manage", "reservation.read", "reservation.create", "reservation.update", "reservation.cancel", "client.read", "client.create", "client.update", "client.history.read.organization", "floorplan.read", "floorplan.manage", "availability.read", "availability.manage", "import.manage", "client.export", "audit.read"]
      },
      "PeopleRoleOption": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } }
      },
      "PeoplePermissionOption": {
        "type": "object", "additionalProperties": false, "required": ["id", "description", "scope"],
        "properties": { "id": { "$ref": "#/components/schemas/PeoplePermissionId" }, "description": { "type": "string" }, "scope": { "type": "string", "enum": ["SELF", "ORGANIZATION", "VENUE"] } }
      },
      "PeopleVenueOption": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "roles", "permissions"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" },
          "roles": { "type": "array", "items": { "$ref": "#/components/schemas/PeopleRoleOption" } },
          "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/PeoplePermissionOption" } }
        }
      },
      "PeopleAddUserOptions": {
        "type": "object", "additionalProperties": false, "required": ["organizationRoles", "organizationPermissions", "venues"],
        "properties": {
          "organizationRoles": { "type": "array", "items": { "$ref": "#/components/schemas/PeopleRoleOption" } },
          "organizationPermissions": { "type": "array", "items": { "$ref": "#/components/schemas/PeoplePermissionOption" } },
          "venues": { "type": "array", "items": { "$ref": "#/components/schemas/PeopleVenueOption" } }
        }
      },
      "CreatePeopleAccountVenueRequest": {
        "type": "object",
        "required": [
          "venueId",
          "roleIds"
        ],
        "additionalProperties": false,
        "properties": {
          "venueId": {
            "type": "string",
            "format": "uuid"
          },
          "permissionIds": {
            "type": "array", "maxItems": 22, "uniqueItems": true,
            "description": "Optional additive direct VENUE grants, checked against current actor rights at this explicit venue.",
            "items": { "$ref": "#/components/schemas/PeoplePermissionId" }
          },
          "roleIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreatePeopleAccountRequest": {
        "type": "object",
        "required": [
          "email",
          "firstName",
          "lastName",
          "jobTitle",
          "emailNotificationsEnabled",
          "suspended",
          "organizationRoleIds",
          "venues"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Unverified organization-scoped provisioning email; never an OIDC identity key."
          },
          "firstName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          },
          "lastName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          },
          "jobTitle": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          },
          "emailNotificationsEnabled": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null means not established; false and true are explicit preferences."
          },
          "suspended": {
            "type": "boolean",
            "description": "ProjectX maps true to User.disabled_at at creation."
          },
          "organizationRoleIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "organizationPermissionIds": {
            "type": "array", "maxItems": 22, "uniqueItems": true,
            "description": "Optional additive direct ORGANIZATION/SELF grants owned by the new membership; no shared-role mutation.",
            "items": { "$ref": "#/components/schemas/PeoplePermissionId" }
          },
          "venues": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CreatePeopleAccountVenueRequest"
            }
          }
        }
      },
      "CreatePeopleAccountResponse": {
        "type": "object",
        "required": [
          "provisioningId",
          "userId",
          "membershipId",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "provisioningId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "const": "PENDING"
          }
        }
      }
    }
  }
}
