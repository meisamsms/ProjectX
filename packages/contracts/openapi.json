            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "BookedByNameList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/BookedByName"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AddBookedByNameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Input budget; after whitespace trim, 1–120 Unicode code points without C0/C1 controls."
          }
        }
      },
      "UpdateBookedByNameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "version"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PeopleAccountSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "jobTitle",
          "emailNotificationsEnabled",
          "accessLevels"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Derived from persisted first and last name; null when both absent."
          },
          "jobTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "emailNotificationsEnabled": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null means unconfigured; false explicitly disabled; true explicitly enabled."
          },
          "accessLevels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sorted, distinct names of active ProjectX organization role grants. No primary-role precedence or venue-role inference."
          }
        }
      },
      "PeopleAccountsResponse": {
        "type": "object",
