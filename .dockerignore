# Allowlist: no API runtime, credentials, tests, Git or local data in web context.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/contracts/
!packages/contracts/package.json
!packages/contracts/tsconfig.json
!packages/contracts/routes.json
!packages/contracts/src/
!packages/contracts/src/**
!packages/contracts/generated/
!packages/contracts/generated/**
!deploy/
!deploy/gateway/
!deploy/gateway/Dockerfile
!deploy/gateway/nginx.conf.template
!deploy/gateway/start.sh
# Defense in depth, even inside allowlisted directories.
**/.env
**/.env.*
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.test.*
**/*.spec.*
**/node_modules/**
**/dist/**
**/coverage/**
**/test-results/**
**/playwright-report/**
**/.git/**
**/tmp/**
**/temp/**
