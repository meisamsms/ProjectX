NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# No production credentials or tenant headers are required for /health.
# Production/staging require staff auth enabled and every input below. Inject secrets outside Git.
STAFF_AUTH_ENABLED=0
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URI=
AUTH0_POST_LOGOUT_URI=
STAFF_APP_ORIGIN=
STAFF_RUNTIME_DATABASE_URL=
# Callback: canonical HTTPS origin + /api/v1/staff-auth/callback. Issuer ends in /.
# Runtime DB login must inherit only the reviewed People/auth roles; never a migration owner.
